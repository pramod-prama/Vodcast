{
	"info": {
		"_postman_id": "sadtalker-api-collection",
		"name": "SadTalker API Collection - Real Files",
		"description": "Collection for testing SadTalker API endpoints with real file uploads",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Health Check",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{base_url}}/api/health",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"health"
					]
				},
				"description": "Check if the API is running and healthy"
			},
			"response": []
		},
		{
			"name": "List All Jobs",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{base_url}}/api/jobs",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"jobs"
					]
				},
				"description": "Get a list of all jobs"
			},
			"response": []
		},
		{
			"name": "Create Job (Basic)",
			"request": {
				"method": "POST",
				"header": [],
				"body": {
					"mode": "formdata",
					"formdata": [
						{
							"key": "preprocess",
							"value": "crop",
							"type": "text"
						},
						{
							"key": "still_mode",
							"value": "false",
							"type": "text"
						},
						{
							"key": "use_enhancer",
							"value": "false",
							"type": "text"
						},
						{
							"key": "batch_size",
							"value": "1",
							"type": "text"
						},
						{
							"key": "size",
							"value": "256",
							"type": "text"
						},
						{
							"key": "pose_style",
							"value": "0",
							"type": "text"
						},
						{
							"key": "source_image",
							"type": "file",
							"src": []
						},
						{
							"key": "driven_audio",
							"type": "file",
							"src": []
						}
					]
				},
				"url": {
					"raw": "{{base_url}}/api/jobs",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"jobs"
					]
				},
				"description": "Create a new job with image and audio files"
			},
			"response": []
		},
		{
			"name": "Create Job (No Files)",
			"request": {
				"method": "POST",
				"header": [],
				"body": {
					"mode": "formdata",
					"formdata": [
						{
							"key": "preprocess",
							"value": "crop",
							"type": "text"
						},
						{
							"key": "still_mode",
							"value": "false",
							"type": "text"
						},
						{
							"key": "use_enhancer",
							"value": "true",
							"type": "text"
						},
						{
							"key": "batch_size",
							"value": "2",
							"type": "text"
						},
						{
							"key": "size",
							"value": "512",
							"type": "text"
						},
						{
							"key": "pose_style",
							"value": "1",
							"type": "text"
						}
					]
				},
				"url": {
					"raw": "{{base_url}}/api/jobs",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"jobs"
					]
				},
				"description": "Create a new job without files (for testing parameters)"
			},
			"response": []
		},
		{
			"name": "Get Job Status",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{base_url}}/api/jobs/{{job_id}}",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"jobs",
						"{{job_id}}"
					]
				},
				"description": "Get the status of a specific job"
			},
			"response": []
		},
		{
			"name": "Delete Job",
			"request": {
				"method": "DELETE",
				"header": [],
				"url": {
					"raw": "{{base_url}}/api/jobs/{{job_id}}",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"jobs",
						"{{job_id}}"
					]
				},
				"description": "Delete a specific job"
			},
			"response": []
		}
	],
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:7860",
			"type": "string"
		},
		{
			"key": "job_id",
			"value": "your-job-id-here",
			"type": "string"
		}
	]
}
